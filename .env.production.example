# Copier vers .env sur le VPS / dans Portainer (Stack env)
NODE_ENV=production
PORT=8787
APP_ENV=production
APP_URL=https://ytmusic.delhomme.ovh

# Obligatoire — génère avec: openssl rand -hex 32
JWT_SECRET=

# Sessions
JWT_ACCESS_TTL=14d
AUTH_COOKIE_MS=34560000000
COOKIE_SECURE=1

# Admins (emails séparés par des virgules)
ADMIN_EMAILS=toi@example.com

# Google Sign-In (optionnel)
GOOGLE_CLIENT_ID=

# Passkeys — doit matcher le domaine public HTTPS
WEBAUTHN_RP_ID=ytmusic.delhomme.ovh
WEBAUTHN_ORIGIN=https://ytmusic.delhomme.ovh

# SMTP (recommandé en prod / préprod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YTMusic <noreply@ytmusic.delhomme.ovh>
# SMTP_SECURE=0

# Image GHCR
YTMUSIC_IMAGE=ghcr.io/paveldelhomme/ytmusic:latest
