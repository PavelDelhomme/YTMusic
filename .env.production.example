# Copier vers .env sur le VPS / dans Portainer (Stack env)
NODE_ENV=production
PORT=8787
APP_ENV=production
APP_URL=https://ytmusic.delhomme.ovh

# Obligatoire — génère avec: openssl rand -hex 32
JWT_SECRET=

# Sessions multi-appareils
JWT_ACCESS_TTL=14d
AUTH_COOKIE_MS=34560000000
COOKIE_SECURE=1

# Admins
ADMIN_EMAILS=paul@delhomme.ovh,dev@delhomme.ovh

# Google Sign-In (optionnel)
GOOGLE_CLIENT_ID=

# Passkeys — doit matcher le domaine public HTTPS
WEBAUTHN_RP_ID=ytmusic.delhomme.ovh
WEBAUTHN_ORIGIN=https://ytmusic.delhomme.ovh

# SMTP OVH MX Plan — maily.ovh (noreply@maily.ovh)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USE_SSL=1
SMTP_USER=noreply@maily.ovh
SMTP_PASS=
SMTP_FROM=YTMusic <noreply@maily.ovh>
SMTP_REPLY_TO=noreply@maily.ovh

# Image GHCR
YTMUSIC_IMAGE=ghcr.io/paveldelhomme/ytmusic:latest

# Réseau NPM (comme taskflow / nextcloud)
# Conteneur hostname pour NPM : ytmusic
# Forward : http://ytmusic:8787  + Websockets ON + SSL Let's Encrypt
