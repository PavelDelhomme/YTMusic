# Copier vers .env sur le VPS / coller dans Portainer (Stack → Environment variables)
# Instance personnelle : UN SEUL compte (celui de ADMIN_EMAILS / AUTH_ALLOWED_EMAILS)

NODE_ENV=production
PORT=8787
APP_ENV=production
APP_URL=https://ytmusic.delhomme.ovh

# Obligatoire — génère avec: openssl rand -hex 32
JWT_SECRET=

# Sessions multi-appareils
JWT_ACCESS_TTL=14d
AUTH_COOKIE_MS=34560000000
COOKIE_SECURE=1

# --- Mode privé (défaut dès APP_ENV=production) ---
# AUTH_PRIVATE=1          # forcé auto en production ; mets 0 seulement pour tests multi-users
AUTH_ALLOW_REGISTER=0     # pas d’inscription ouverte
AUTH_ALLOW_GUEST=0        # pas de comptes invités
# Emails autorisés à se connecter (sinon = ADMIN_EMAILS)
AUTH_ALLOWED_EMAILS=toi@email.com
ADMIN_EMAILS=toi@email.com

# Optionnel : protège le lien APK (?key=…) — laisse vide pour QR Admin simple
# APK_DOWNLOAD_TOKEN=

# Google Sign-In (optionnel — même email allowlisté)
GOOGLE_CLIENT_ID=

# Passkeys — doit matcher le domaine public HTTPS
WEBAUTHN_RP_ID=ytmusic.delhomme.ovh
WEBAUTHN_ORIGIN=https://ytmusic.delhomme.ovh

# SMTP OVH MX Plan — maily.ovh
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USE_SSL=1
SMTP_USER=noreply@maily.ovh
SMTP_PASS=
SMTP_FROM="YTMusic <noreply@maily.ovh>"
SMTP_REPLY_TO=noreply@maily.ovh

# Image GHCR (après push branche prod)
YTMUSIC_IMAGE=ghcr.io/paveldelhomme/ytmusic:latest
