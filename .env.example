# Auth
JWT_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
# Optional: Google OAuth client ID from Google Cloud Console
# Enable Google Identity Services for http://localhost:5173

# Comma-separated admin emails (first registered user is also admin)
ADMIN_EMAILS=

# Environnement : local | preprod | production
APP_ENV=local
# URL publique de l’app (liens emails de validation)
APP_URL=http://localhost:5173

# Sessions longues (access JWT + refresh ~400j)
# JWT_ACCESS_TTL=14d
# AUTH_COOKIE_MS=34560000000

# SMTP (optionnel en local — sinon outbox admin + logs console)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=YTMusic <noreply@ytmusic.local>
# SMTP_SECURE=0

# WebAuthn / Passkeys (defaults to request hostname — fine for localhost & LAN IP)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

PORT=8787
