# Auth
JWT_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
# Optional: Google OAuth client ID from Google Cloud Console
# Enable Google Identity Services for http://localhost:5173

# Comptes admin (emails séparés par des virgules)
ADMIN_EMAILS=paul@delhomme.ovh,dev@delhomme.ovh

# Environnement : local | preprod | production
APP_ENV=local
# Liens emails de validation — en local + ADB : http://127.0.0.1:5173
# (adb reverse rend localhost accessible sur le téléphone)
# En prod : https://ytmusic.delhomme.ovh
APP_URL=http://127.0.0.1:5173

# Sessions longues (access JWT + refresh ~400j) — multi-appareils
JWT_ACCESS_TTL=14d
AUTH_COOKIE_MS=34560000000

# ---------------------------------------------------------------------------
# SMTP OVH MX Plan — domaine maily.ovh (même socle que JobbingTrack)
# Compte technique : noreply@maily.ovh
# Webmail : Roundcube OVH
# ---------------------------------------------------------------------------
# Local sans SMTP : laisse SMTP_HOST vide → outbox admin + logs console
# Local avec Mailhog (docker-compose.dev) :
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURE=0
# Envoi réel (recommandé pour tester validation email) :
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USE_SSL=1
SMTP_USER=noreply@maily.ovh
SMTP_PASS=
SMTP_FROM="YTMusic <noreply@maily.ovh>"
SMTP_REPLY_TO=noreply@maily.ovh

# WebAuthn / Passkeys (defaults to request hostname — fine for localhost & LAN IP)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

PORT=8787

# Seed comptes locaux (scripts/seed-users.mjs) — ne jamais committer le mot de passe
# SEED_PASSWORD=
